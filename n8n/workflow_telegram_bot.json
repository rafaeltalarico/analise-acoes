    {
      "parameters": {
        "jsCode": "const u = $input.first().json.body || $input.first().json;\nlet chatId, action, data = {}, callbackQueryId = null;\n\nif (u.callback_query) {\n  callbackQueryId = u.callback_query.id;\n  chatId = String(u.callback_query.message.chat.id);\n  const cb = u.callback_query.data || '';\n\n  if (cb === 'menu')               action = 'send_menu';\n  else if (cb === 'buscar_ticker') action = 'ask_ticker';\n  else if (cb === 'buscar_ativos') action = 'send_buscar';\n  else if (cb === 'setores')       action = 'send_sectors';\n  else if (cb === 'ganhos')        { action = 'get_movers'; data = { type: 'gainers' }; }\n  else if (cb === 'perdas')        { action = 'get_movers'; data = { type: 'losers'  }; }\n  else if (cb === 'resumo_dia')    action = 'get_summary';\n  else if (cb.startsWith('setor_'))   { action = 'get_sector'; data = { sector: cb.slice(6) }; }\n  else if (cb.startsWith('analyze_')) { action = 'analyze';    data = { ticker: cb.slice(8) }; }\n  else action = 'send_menu';\n\n} else if (u.message) {\n  chatId = String(u.message.chat.id);\n  const txt = (u.message.text || '').trim().toUpperCase();\n  const menuTriggers = ['/START', '/MENU', 'MENU', 'START', 'OI', 'OLA', 'OLOI', 'INICIO'];\n\n  if (menuTriggers.includes(txt)) {\n    action = 'send_menu';\n  } else if (/^[A-Z]{1,5}(-[A-Z])?$/.test(txt)) {\n    action = 'analyze';\n    data = { ticker: txt };\n  } else {\n    action = 'send_menu';\n  }\n} else {\n  return [];\n}\n\nreturn [{ json: { chatId, action, data, callbackQueryId } }];"
      },
