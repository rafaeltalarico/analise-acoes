    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst chatId = $('Parse Input').item.json.chatId;\nconst sector = res.sector || 'Setor';\nconst results = res.results || [];\n\nlet text = `<b>🏣 ${sector}</b>\\n<i>Top ${results.length} por Market Cap</i>\\n\\n`;\nresults.forEach((s, i) => {\n  const chg = s.change_pct != null ? ` ${s.change_pct >= 0 ? '📈 +' : '📉 '}${s.change_pct}%` : '';\n  const cap = s.market_cap_fmt ? ` · ${s.market_cap_fmt}` : '';\n  text += `${i + 1}. <b>${s.ticker}</b>  $${s.price}${chg}${cap}\\n`;\n});\ntext += '\\n<i>Toque em um ativo para análise completa:</i>';\n\nconst keyboard = results.map(s => ([{ text: `${s.ticker}  $${s.price}${s.change_pct != null ? (s.change_pct >= 0 ? ' 📈' : ' 📉') : ''}`, callback_data: `analyze_${s.ticker}` }]));\nkeyboard.push([{ text: '🏣 Outros Setores', callback_data: 'setores' }, { text: '🔙 Voltar', callback_data: 'buscar_ativos' }]);\n\nreturn [{ json: { chatId, text, replyMarkup: JSON.stringify({ inline_keyboard: keyboard }) } }];"
      },
