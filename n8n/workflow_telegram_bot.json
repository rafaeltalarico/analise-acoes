    {
      "parameters": {
        "jsCode": "const API = 'http://127.0.0.1:8000';\nconst chatId = $('Parse Input').item.json.chatId;\n\nconst [g, l] = await Promise.all([\n  $helpers.httpRequest({ method: 'GET', url: `${API}/api/market/movers?type=gainers&limit=5` }),\n  $helpers.httpRequest({ method: 'GET', url: `${API}/api/market/movers?type=losers&limit=5` })\n]);\n\nconst gainers = g.results || [];\nconst losers  = l.results || [];\nconst date    = g.date || new Date().toISOString().slice(0, 10);\n\nlet text = `<b>📋 RESUMO DO DIA — ${date}</b>\\n\\n`;\ntext += '<b>📈 Maiores Altas:</b>\\n';\ngainers.forEach((s, i) => { text += `${i + 1}. <b>${s.ticker}</b>  +${s.change_pct}%  $${s.price}\\n`; });\ntext += '\\n<b>📉 Maiores Baixas:</b>\\n';\nlosers.forEach((s, i) => { text += `${i + 1}. <b>${s.ticker}</b>  ${s.change_pct}%  $${s.price}\\n`; });\n\nconst replyMarkup = JSON.stringify({ inline_keyboard: [[{ text: '📊 Analisar Ativo', callback_data: 'buscar_ticker' }, { text: '🔙 Menu', callback_data: 'menu' }]] });\n\nreturn [{ json: { chatId, text, replyMarkup } }];"
      },
