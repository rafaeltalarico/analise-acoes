    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst chatId = $('Parse Input').item.json.chatId;\nconst type = res.type;\nconst results = res.results || [];\n\nconst icon  = type === 'gainers' ? '📈' : '📉';\nconst title = type === 'gainers' ? 'PRINCIPAIS GANHOS' : 'PRINCIPAIS PERDAS';\n\nlet text = `<b>${icon} ${title} — ${res.date || ''}</b>\\n\\n`;\nresults.forEach((s, i) => {\n  const sign = s.change_pct >= 0 ? '+' : '';\n  text += `${i + 1}. <b>${s.ticker}</b>  $${s.price}  ${sign}${s.change_pct}%\\n`;\n});\ntext += '\\n<i>Toque em um ativo para análise completa:</i>';\n\nconst keyboard = results.map(s => ([{\n  text: `${s.ticker}  ${s.change_pct >= 0 ? '📈 +' : '📉 '}${s.change_pct}%`,\n  callback_data: `analyze_${s.ticker}`\n}]));\nkeyboard.push([{ text: '🔙 Voltar', callback_data: 'buscar_ativos' }]);\n\nreturn [{ json: { chatId, text, replyMarkup: JSON.stringify({ inline_keyboard: keyboard }) } }];"
      },
